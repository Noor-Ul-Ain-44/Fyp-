import rclpy
from rclpy.node import Node
from std_msgs.msg import String

class MQTTBridgeSubscriber(Node):
    def __init__(self):
        super().__init__('mqtt_bridge_subscriber')
        # Subscribe to the same topic used by the publisher
        self.subscription = self.create_subscription(
            String,
            'robot_command',
            self.listener_callback,
            10)

    def listener_callback(self, msg):
        # This is where the ROS 2 message is received.
        # In Phase 2, this will be modified to publish to MQTT.
        self.get_logger().info(f'ROS 2 Received: "{msg.data}"')
        # For now, we just print the received message.

def main(args=None):
    rclpy.init(args=args)
    node = MQTTBridgeSubscriber()
    rclpy.spin(node)
    node.destroy_node()
    rclpy.shutdown()

if __name__ == '__main__':
    main()
